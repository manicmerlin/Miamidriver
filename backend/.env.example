# Vision provider for tag OCR / brand classification.
# One of: anthropic, stub
VISION_PROVIDER=stub

# Required when VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Where SQLite + cached scraped HTML go
DATA_DIR=./var

# HTTP client behaviour for marketplace fetches
USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Safari/605.1.15
FETCH_TIMEOUT_SECONDS=20
