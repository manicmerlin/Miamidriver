# Vision provider for tag OCR / brand classification.
# One of: anthropic, stub
VISION_PROVIDER=stub

# Runtime web research for sizing — when the curated KB has no `researched`
# entry, the backend will call Anthropic's web_search tool to look up
# canonical measurements live and tag them with citations.
# One of: anthropic, off
RESEARCH_PROVIDER=off

# Required when VISION_PROVIDER=anthropic OR RESEARCH_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Where SQLite + cached scraped HTML go
DATA_DIR=./var

# HTTP client behaviour for marketplace fetches
USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Safari/605.1.15
FETCH_TIMEOUT_SECONDS=20
