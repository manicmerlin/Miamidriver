# Optional integrations (Phase 1 leaves Supabase off; only n8n + Telegram).
# These are read at runtime from app settings (stored on-device); .env values
# are only used as defaults during onboarding.

# n8n webhook (Path B — events out from app)
N8N_WEBHOOK_BASE=
N8N_WEBHOOK_TOKEN=

# Telegram bot — only the n8n side needs the bot token; the app only needs
# the same N8N_WEBHOOK_BASE for inbound polling of remote-captured items.
