# La Di Da — environment variable scaffold (NEVER commit real secrets)

# AI providers (provider-agnostic; flip via AI_PROVIDER below)
AI_PROVIDER=stub          # stub | fal | replicate
FAL_API_KEY=
REPLICATE_API_TOKEN=
GOOGLE_AI_STUDIO_KEY=     # for Veo 3.1 Lite

# Identity verification (must be live before generation)
ID_VERIFY_PROVIDER=stub   # stub | persona | stripe-identity | veriff
PERSONA_API_KEY=
VERIFF_API_KEY=

# Moderation — both are required in production
HIVE_API_KEY=
THORN_SAFER_API_KEY=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=la-di-da

# Database
DATABASE_URL=

# Adult-friendly merchant processors (DO NOT use Stripe — see README)
CCBILL_ACCOUNT=
CCBILL_SUBACCOUNT=
SEGPAY_PACKAGE_ID=
EPOCH_PI_CODE=
NOWPAYMENTS_API_KEY=
