# La Di Da — environment variable scaffold (NEVER commit real secrets)

# ── AI provider selection ───────────────────────────────────────────────
# Pick which adapter handles /api/generate.
#   stub     — local placeholder gradients (default; no keys needed)
#   fal      — fal.ai Flux + InstantID + Kling video
#   replicate — Replicate Pony XL / Flux / SDXL
#   runpod   — your own self-hosted worker in infra/runpod-worker
AI_PROVIDER=stub

# fal.ai — value should be '<key_id>:<key_secret>' (one string with one colon).
# Either name works; FAL_KEY matches fal's docs.
FAL_KEY=
FAL_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# Google AI Studio (for Veo 3.1 Lite)
GOOGLE_AI_STUDIO_KEY=

# ── RunPod self-hosted worker ───────────────────────────────────────────
# Created when you deploy infra/runpod-worker as a serverless endpoint.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Optional: a default LoRA URL the worker should apply if mintLoraUrl()
# isn't wired yet. Useful for smoke-testing without the presigner.
RUNPOD_DEFAULT_LORA_URL=

# ── S3-compatible storage (Wasabi / Bunny / Backblaze B2 / DO Spaces) ──
# Cloudflare R2 explicitly forbids adult content — do not use it here.
# Wasabi is the cheapest adult-friendly default.
S3_ENDPOINT_URL=https://s3.wasabisys.com
S3_REGION=us-east-1
S3_BUCKET=ladida-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix for serving uploaded assets (Bunny CDN pull zone, or
# the Wasabi public bucket URL). The worker concatenates the key onto this.
S3_PUBLIC_URL=https://cdn.ladida.studio

# ── Identity verification ───────────────────────────────────────────────
ID_VERIFY_PROVIDER=stub          # stub | persona | stripe-identity | veriff
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=             # itmpl_xxx — created in Persona dashboard
PERSONA_WEBHOOK_SECRET=          # rotate when sharing
VERIFF_API_KEY=

# ── Moderation (both required in production) ────────────────────────────
HIVE_API_KEY=
THORN_SAFER_API_KEY=
# When MODERATION_REQUIRED=1, missing keys / API errors fail closed.
# Leave unset in dev so the stub provider keeps working.
MODERATION_REQUIRED=0

# ── Background queue (optional — falls back to inline generation) ───────
# Set REDIS_URL to put generation on a BullMQ queue and run `npm run worker`
# in a separate process. Without it, /api/generate runs synchronously.
REDIS_URL=
QUEUE_CONCURRENCY=4

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Public base URL (used in webhooks / success URLs) ───────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Adult-friendly merchant processing (DO NOT use Stripe) ──────────────
BILLING_PROCESSOR=ccbill         # ccbill | segpay | nowpayments
CCBILL_ACCOUNT=
CCBILL_SUBACCOUNT=
CCBILL_FORM_NAME=
CCBILL_FLEX_FORM_ID=
CCBILL_ALLOWED_IPS=              # comma-separated; populated from CCBill admin
SEGPAY_MERCHANT_ID=
SEGPAY_PACKAGE_ID=
EPOCH_PI_CODE=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
